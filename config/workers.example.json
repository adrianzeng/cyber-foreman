{
  "port": 4647,
  "dataDir": "./data",
  "workers": {
    "claude-main": {
      "name": "Claude 主员工",
      "kind": "claude-cli",
      "command": "claude",
      "cwd": "C:\\path\\to\\trusted-workspace",
      "permissionMode": "acceptEdits",
      "model": "",
      "effort": "",
      "disabled": "auto",
      "retry": {
        "maxAttempts": 3,
        "baseDelayMs": 3000,
        "maxDelayMs": 60000
      }
    },
    "codex-main": {
      "name": "Codex 员工",
